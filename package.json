{
  "name": "remote-iterm-mobile",
  "version": "1.2.1",
  "description": "Mobile-optimized control of iTerm2 from your phone over your local network",
  "bin": {
    "remote-iterm": "iterm-server"
  },
  "scripts": {
    "postinstall": "cd server && npm install && cd ../client && npm install",
    "start": "./iterm-server start",
    "stop": "./iterm-server stop",
    "restart": "./iterm-server restart"
  },
  "keywords": [
    "iterm",
    "iterm2",
    "terminal",
    "remote",
    "macos",
    "mobile",
    "applescript",
    "opencode",
    "iphone"
  ],
  "author": "Ziya Mammadov",
  "contributors": [
    "Smowtion"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smowtion/remote-iterm-mobile.git"
  },
  "homepage": "https://github.com/smowtion/remote-iterm-mobile#readme",
  "bugs": {
    "url": "https://github.com/smowtion/remote-iterm-mobile/issues"
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "iterm-server",
    "server/",
    "client/",
    "!server/node_modules",
    "!client/node_modules",
    "!client/dist",
    "README.md",
    "LICENSE"
  ]
}
